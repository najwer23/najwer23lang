{
  "name": "najwer23lang",
  "version": "0.1.0",
  "description": "Write plain text in T(\"...\"), extract every phrase to JSON, translate. Zero dependencies, never deletes a translation.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": "./bin/cli.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./extract": {
      "types": "./src/extract.d.ts",
      "default": "./src/extract.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "god": "yarn publish:patch",
    "format": "biome check --write",
    "publish:patch": "npm version patch --force && npm publish && rimraf ./lib && rimraf ./.yarn/cache"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "rimraf": "^6.1.3"
  },
  "keywords": [
    "i18n",
    "translation",
    "localization",
    "l10n",
    "extract",
    "react",
    "json",
    "cli",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najwer23/najwer23lang"
  },
  "author": "Mariusz Najwer (https://najwer23.github.io/)",
  "license": "MIT"
}
